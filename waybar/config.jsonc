{
	"layer": "top",
	"position": "top",
	"height": 30,

	"modules-left": [
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		"hyprland/language",
		"network",
		"pulseaudio",
		"battery",
		"clock"
	],

	"hyprland/language": {
		"format": "{}",
		"format-es": "ES",
		"format-pl": "PL",
		"keyboard-name": "at-translated-set-2-keyboard"
	},

	"hyprland/workspaces": {
		"format": "{name}"
	},

	"hyprland/window": {
		"format": "{}"
	},

	"network": {
		"format-wifi": "WiFi {essid}",
		"format-ethernet": "ETH {ifname}",
		"format-disconnected": "Offline"
	},

	"pulseaudio": {
		"format": "Vol {volume}%"
	},

	"battery": {
		"format": "Bat {capacity}%",
		"format-charging": "Bat {capacity}% +",
		"format-plugged": "Bat {capacity}% +",
		"states": {
			"warning": 30,
			"critical": 15
		}
	},

	"clock": {
		"format": "{:%a %d %b  %H:%M}",
		"tooltip-format": "<span size='13pt' font='DejaVu Sans Mono'>{:%A, %B %d, %Y}\n\n{calendar}</span>",
		"calendar": {
			"mode": "month",
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#81a1c1'><b>{}</b></span>",
				"weeks": "<span color='#4c566a'><b>W{}</b></span>",
				"weekdays": "<span color='#88c0d0'><b>{}</b></span>",
				"today": "<span color='#ebcb8b'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click": "gsimplecal",
			"on-click-right": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	}
}
