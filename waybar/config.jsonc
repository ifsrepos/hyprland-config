{
	"layer": "top",
	"position": "top",
	"height": 30,

	"modules-left": [
		"hyprland/workspaces"
	],

	"modules-center": [
		"hyprland/window"
	],

	"modules-right": [
		"hyprland/language",
		"network",
		"pulseaudio",
		"battery",
		"clock"
	],

	"hyprland/language": {
		"format": "{}",
		"format-es": "ES",
		"format-pl": "PL",
		"keyboard-name": "at-translated-set-2-keyboard"
	},

	"hyprland/workspaces": {
		"format": "{name}"
	},

	"hyprland/window": {
		"format": "{}"
	},

	"network": {
		"format-wifi": "WiFi {essid}",
		"format-ethernet": "ETH {ifname}",
		"format-disconnected": "Offline"
	},

	"pulseaudio": {
		"format": "Vol {volume}%"
	},

	"battery": {
		"format": "Bat {capacity}%"
	},

	"clock": {
		"format": "{:%H:%M}"
	}
}
