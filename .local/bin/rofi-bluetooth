#!/bin/bash
# rofi-bluetooth: Manage Bluetooth devices and power using rofi and bluetoothctl

set -e

# Show notification (with fallback if notify-send fails)
show_notification() {
    local title=$1
    local message=$2
    if command -v notify-send &> /dev/null && notify-send "$title" "$message" 2>/dev/null; then
        return
    fi
    # Fallback to rofi
    rofi -e "$title: $message" &
}

# Main menu
show_main_menu() {
    local bt_status=$(bluetoothctl show | grep "Powered:" | awk '{print $2}')
    local status_text="[$([ "$bt_status" = "yes" ] && echo "ON" || echo "OFF")]"

    echo "Toggle Bluetooth $status_text"
    echo "Paired Devices"
    echo "Scan for Devices"
}

# Get paired devices with connection status
show_paired_devices() {
    bluetoothctl devices Paired | while read -r line; do
        if [ -n "$line" ]; then
            device_addr=$(echo "$line" | awk '{print $2}')
            device_name=$(echo "$line" | cut -d' ' -f3-)

            # Check if connected
            is_connected=$(bluetoothctl info "$device_addr" | grep "Connected:" | awk '{print $2}')
            status="$([ "$is_connected" = "yes" ] && echo "✓" || echo "○")"

            echo "$status $device_name ($device_addr)"
        fi
    done
}

# Get discoverable devices (scan results)
show_scan_devices() {
    local paired_macs=$(bluetoothctl devices Paired | awk '{print $2}')

    # Use interactive bluetoothctl to scan and list devices
    (
        echo "scan on"
        sleep 12
        echo "devices"
        sleep 1
        echo "quit"
    ) | bluetoothctl 2>&1 | grep "^Device" | while read -r line; do
        if [ -n "$line" ]; then
            device_addr=$(echo "$line" | awk '{print $2}')
            # Skip if this device is already paired
            if echo "$paired_macs" | grep -q "^$device_addr$"; then
                continue
            fi
            device_name=$(echo "$line" | cut -d' ' -f3-)
            echo "⊕ $device_name ($device_addr)"
        fi
    done
}

# Connect to device
connect_device() {
    local device_addr=$1
    bluetoothctl connect "$device_addr" > /dev/null 2>&1 &
    sleep 2
}

# Disconnect from device
disconnect_device() {
    local device_addr=$1
    bluetoothctl disconnect "$device_addr" > /dev/null 2>&1
}

# Toggle Bluetooth power
toggle_bluetooth() {
    local current=$(bluetoothctl show | grep "Powered:" | awk '{print $2}')
    if [ "$current" = "yes" ]; then
        bluetoothctl power off
    else
        bluetoothctl power on
    fi
}

# Pair with device (run in interactive mode like user does)
pair_device() {
    local device_addr=$1
    local device_name=$2

    # Run pairing in interactive mode and capture output
    local output=$(
        (
            echo "pair $device_addr"
            sleep 5
            echo "connect $device_addr"
            sleep 2
            echo "trust $device_addr"
            sleep 1
            echo "quit"
        ) | bluetoothctl 2>&1
    )

    # Check if pairing succeeded
    if echo "$output" | grep -q "Pairing successful\|Device added"; then
        show_notification "Bluetooth" "Successfully paired with $device_name"
        return 0
    elif echo "$output" | grep -q "Failed\|Error"; then
        local error=$(echo "$output" | grep -i "failed\|error" | head -1)
        show_notification "Bluetooth" "Pairing failed: $error"
        return 1
    else
        show_notification "Bluetooth" "Paired and connected to $device_name"
        return 0
    fi
}

# Main flow
choice=$(show_main_menu | rofi -dmenu -p "Bluetooth: " -i \
    -width 1200 -lines 3 -font "monospace 12" \
    -theme-str "window { height: 80%; } listview { dynamic: false; }")

if [ -z "$choice" ]; then
    exit 0
fi

case "$choice" in
    Toggle*)
        toggle_bluetooth
        show_notification "Bluetooth" "Power toggled"
        ;;
    "Paired Devices")
        device_choice=$(show_paired_devices | rofi -dmenu -p "Select Device: " -i \
            -width 1200 -font "monospace 12" \
            -theme-str "window { height: 80%; } listview { dynamic: false; }")

        if [ -z "$device_choice" ]; then
            exit 0
        fi

        device_addr=$(echo "$device_choice" | grep -oE '\([0-9A-F:]+\)' | tr -d '()')
        is_connected=$(bluetoothctl info "$device_addr" | grep "Connected:" | awk '{print $2}')

        if [ "$is_connected" = "yes" ]; then
            disconnect_device "$device_addr"
            show_notification "Bluetooth" "Disconnected from $(echo "$device_choice" | sed 's/ (.*//g')"
        else
            connect_device "$device_addr"
            show_notification "Bluetooth" "Connecting to $(echo "$device_choice" | sed 's/ (.*//g')..."
        fi
        ;;
    "Scan for Devices")
        device_choice=$(show_scan_devices | rofi -dmenu -p "Select Device: " -i \
            -width 1200 -font "monospace 12" \
            -theme-str "window { height: 80%; } listview { dynamic: false; }")

        if [ -z "$device_choice" ]; then
            exit 0
        fi

        device_addr=$(echo "$device_choice" | grep -oE '\([0-9A-F:]+\)' | tr -d '()')
        device_name=$(echo "$device_choice" | sed 's/ (.*//g' | sed 's/^. //')

        show_notification "Bluetooth" "Pairing with $device_name..."
        pair_device "$device_addr" "$device_name"
        ;;
esac
